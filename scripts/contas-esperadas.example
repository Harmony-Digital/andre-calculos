# Contas e destinos esperados deste projeto (AGENTS.md §7).
# Não são segredos: são nomes e identificadores para conferir que a sessão
# está ligada às contas certas. O scripts/preflight.sh compara com isto no início de toda sessão.
# Campo vazio = ainda não conhecido; preencher assim que o valor for confirmado.

PROJETO="andre-calculos"

# GitHub: repositório na organização Harmony-Digital, operado com a conta do Fábio
# (criado em 2026-10-10 na conta pessoal e transferido para a organização no mesmo dia)
GITHUB_USUARIO="fabioalmeidadigital"
GITHUB_REPO="Harmony-Digital/andre-calculos"

# 1Password: cofre do projeto e item das Chaves do macOS com o token da conta de serviço
OP_COFRE="proj-andre-calculos"
OP_CHAVEIRO="op-sa-andre-calculos-agente"

# MCPs deste projeto (definidos no .mcp.json)
MCP_SUPABASE="andre-calculos-supabase"
MCP_VERCEL="andre-calculos-vercel"

# Supabase: conta nova do cliente
SUPABASE_ORG=""            # nome da organização do cliente no Supabase
SUPABASE_PROJECT_REF="qtofwbxujshroaafxowr"    # informado pelo Fábio em 2026-10-10; o MCP do projeto fica restrito a ele

# Vercel: conta nova do cliente
VERCEL_TEAM="projeto-andre1" # equipe Projeto Andre, registrada no plan.md
VERCEL_PROJETO=""          # nome do projeto na Vercel
# Preencher depois da conferência do projeto em M1.50; nenhum ID presumido.
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""
VERCEL_USUARIO=""          # username devolvido por whoami com token do cliente
VERCEL_REPOSITORIO=""      # vínculo conferido na Vercel: Harmony-Digital/andre-calculos
VERCEL_PRODUCTION_BRANCH="" # branch conferida na Vercel: main
APP_ORIGIN_PRODUCAO=""     # origem HTTPS aprovada, sem path/query
APP_ORIGIN_PREVIEW=""      # origem própria de preview, sem path/query
SUPABASE_PREVIEW_PROJECT_REF="" # banco de dados fictícios; nunca o projeto de produção
# Fábio confirma D14 e sua conta pessoal; o agente não consulta estes cofres.
OP_COFRE_PRODUCAO=""
OP_EMAIL_FABIO=""

# MCPs de outras contas, bloqueados neste projeto no .claude/settings.json
MCPS_BLOQUEADOS="supabase harmony-supabase supabase-leonardo claude_ai_Vercel github hostinger lovable"
